# Copia este archivo como apps/web/.env.local. Nunca subas .env.local al repo.

# Horas entre sincronizaciones automáticas con Simplify. 168 = una vez por semana.
UNI_SYNC_MAX_AGE_HOURS=168

# Carpeta para la copia local de listings.json. Por defecto: apps/web/.cache
# UNI_CACHE_DIR=

# --- Fase 2 (todavía no se usan) ---
# ID de tu Google Sheet: la parte entre /d/ y /edit en la URL.
# UNI_SHEET_ID=
# Ruta al JSON de la service account de Google. Guárdalo fuera del repo.
# GOOGLE_APPLICATION_CREDENTIALS=
