# Copy this file to apps/web/.env.local. Never commit .env.local.

# Hours between automatic syncs with Simplify. 168 = once a week.
UNI_SYNC_MAX_AGE_HOURS=168

# Folder for the local copy of listings.json. Default: apps/web/.cache (/tmp/uni-cache on Vercel)
# UNI_CACHE_DIR=

# --- M3 · Google Sheets ---
# Setup steps: docs/SHEETS.md. Without the three required variables the inbox still works,
# without hiding applied roles or the "Mark as applied" button.

# Required. Your Google Sheet ID: the part between /d/ and /edit in its URL.
UNI_SHEET_ID=
# Required. The service account's client_email, ending in .iam.gserviceaccount.com.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Required. The service account's private_key, on one line with each newline written as \n.
GOOGLE_PRIVATE_KEY=
# Optional. Written to the Resume Version column of new rows. Default: empty.
UNI_RESUME_VERSION=
# Optional. Time zone for the Date Applied column. Default: America/New_York.
UNI_TIME_ZONE=
# Optional. Name of your applications tab. Default: Tracker.
UNI_SHEET_TAB=
