# Copy this file to apps/web/.env.local. Never commit .env.local.

# Hours between automatic syncs with Simplify. 168 = once a week.
UNI_SYNC_MAX_AGE_HOURS=168

# Folder for the local copy of listings.json. Default: apps/web/.cache (/tmp/uni-cache on Vercel)
# UNI_CACHE_DIR=

# --- M3 · Google Sheets (not used yet) ---
# Your Google Sheet ID: the part between /d/ and /edit in its URL.
# UNI_SHEET_ID=
# Service account credentials. Keep them out of the repo.
# GOOGLE_APPLICATION_CREDENTIALS=
